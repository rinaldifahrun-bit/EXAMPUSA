{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document storing staff and administrative identity",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the user"
        },
        "role": {
          "type": "string",
          "enum": ["teacher", "student", "admin"],
          "description": "Access control role"
        },
        "nip": {
          "type": "string",
          "maxLength": 30,
          "description": "Teacher Civil Servant Identification Number (NIP)"
        },
        "username": {
          "type": "string",
          "maxLength": 50,
          "description": "Administrator login username"
        },
        "status": {
          "type": "string",
          "enum": ["active", "suspended"],
          "description": "Account status"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "status"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Exam definition and snapshot questions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "subject_name": { "type": "string" },
        "duration_minutes": { "type": "number" },
        "pin": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["draft", "active", "finished"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "owner_id", "title", "pin", "status"]
    },
    "Question": {
      "title": "Question",
      "description": "Bank Question master item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "owner_id": { "type": "string" },
        "subject_id": { "type": "string" },
        "question_text": { "type": "string" },
        "question_type": { "type": "string", "enum": ["multiple_choice", "multiple_select", "true_false", "essay"] },
        "points": { "type": "number" },
        "status": { "type": "string", "enum": ["draft", "reviewed", "ready"] }
      },
      "required": ["id", "owner_id", "question_text", "question_type", "points"]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Student exam participation session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exam_id": { "type": "string" },
        "student_id": { "type": "string" },
        "status": { "type": "string", "enum": ["ongoing", "submitted", "timed_out"] },
        "started_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "exam_id", "student_id", "status"]
    },
    "StudentAnswer": {
      "title": "StudentAnswer",
      "description": "Individual student answer item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "exam_id": { "type": "string" },
        "student_id": { "type": "string" },
        "question_id": { "type": "string" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "session_id", "exam_id", "student_id", "question_id"]
    },
    "ExamResult": {
      "title": "ExamResult",
      "description": "Final score and assessment result",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "exam_id": { "type": "string" },
        "student_id": { "type": "string" },
        "percentage": { "type": "number" },
        "grade": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "awaiting_manual_grading", "finalized"] }
      },
      "required": ["id", "exam_id", "student_id", "percentage", "status"]
    },
    "SecurityEvent": {
      "title": "SecurityEvent",
      "description": "Anti-cheat violation audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "exam_id": { "type": "string" },
        "student_id": { "type": "string" },
        "event_type": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "session_id", "exam_id", "student_id", "event_type", "severity"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Master subject entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "code", "status"]
    },
    "SchoolClass": {
      "title": "SchoolClass",
      "description": "Master school class entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile supporting multi-subject and multi-class teaching assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "nip": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["teacher"] },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "nip", "name", "role", "status"]
    },
    "TeacherAssignment": {
      "title": "TeacherAssignment",
      "description": "Assignment mapping teacher to a subject and multiple classes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "subjectId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "teacherId", "subjectId", "status"]
    }
  },
  "firestore": {
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Master subjects collection"
    },
    "/classes/{classId}": {
      "schema": "SchoolClass",
      "description": "Master classes collection"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Master teacher profiles collection"
    },
    "/teacherAssignments/{assignmentId}": {
      "schema": "TeacherAssignment",
      "description": "Teacher subject and class assignments"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles for teachers, students, and administrators"
    },
    "/exams/{examId}": {
      "schema": "Exam",
      "description": "School exams collection"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Master question bank"
    },
    "/examSessions/{sessionId}": {
      "schema": "ExamSession",
      "description": "Student live exam sessions"
    },
    "/answers/{answerId}": {
      "schema": "StudentAnswer",
      "description": "Student submitted answers"
    },
    "/results/{resultId}": {
      "schema": "ExamResult",
      "description": "Graded exam results"
    },
    "/securityEvents/{eventId}": {
      "schema": "SecurityEvent",
      "description": "Anti-cheat and integrity audit log"
    }
  }
}
